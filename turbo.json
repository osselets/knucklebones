{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_WORKER_URL"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "outputs": ["dist/**"],
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
